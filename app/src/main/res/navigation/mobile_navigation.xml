<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.myapplication.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_incident"
            app:destination="@id/navigation_incident" />
        <action
            android:id="@+id/action_home_to_activity_log"
            app:destination="@id/navigation_activity_log" />
        <action
            android:id="@+id/action_home_to_emergency_contacts"
            app:destination="@id/navigation_emergency_contacts" />
    </fragment>

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.myapplication.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.myapplication.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_incident"
        android:name="com.example.myapplication.ui.incident.IncidentFragment"
        android:label="Log Incident"
        tools:layout="@layout/fragment_incident">
        <argument
            android:name="incidentId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/navigation_activity_log"
        android:name="com.example.myapplication.ui.activitylog.ActivityLogFragment"
        android:label="Activity Log"
        tools:layout="@layout/fragment_activity_log">
        <action
            android:id="@+id/action_activity_log_to_home"
            app:destination="@id/navigation_home" />
        <action
            android:id="@+id/action_activity_log_to_edit_incident"
            app:destination="@id/navigation_incident" />
    </fragment>

    <fragment
        android:id="@+id/navigation_emergency_contacts"
        android:name="com.example.myapplication.ui.emergencycontacts.EmergencyContactsFragment"
        android:label="Emergency Contacts"
        tools:layout="@layout/fragment_emergency_contacts" />
</navigation>